@model wt_lab4_4mvc_valkovich.Models.Book

@{
    ViewData["Title"] = "Подробности";
}

<div class="container">

    <div class="coquette-detail-card mx-auto" style="max-width: 800px;">

        <div class="coquette-detail-header">
            <i class="bi bi-book-heart mb-2" style="font-size: 2.5rem;"></i>
            <h2>@Model.Title</h2>
        </div>

        <div class="coquette-detail-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <p><strong>ID:</strong> @Model.Id</p>
                    <p><strong>Автор:</strong> @Model.Author</p>
                    <p><strong>Жанр:</strong> @Model.Genre</p>
                    <p><strong>Год издания:</strong> @Model.Year</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Страниц:</strong> @Model.Pages</p>
                    <p><strong>ISBN:</strong> @Model.ISBN</p>
                    <p>
                        <strong>Статус:</strong>
                        @if (Model.IsAvailable)
                        {
                        <span class="badge-coquette badge-coquette-success">♡ в наличии</span>
                        }
                        else
                        {
                        <span class="badge-coquette badge-coquette-danger">✕ нет</span>
                        }
                    </p>
                    <p><strong>Цена:</strong> <span class="coquette-price">@Model.Price ₽</span></p>
                </div>
            </div>

            <div class="coquette-divider">♡</div>

            <p><strong>Описание:</strong></p>
            <p style="color: var(--coq-text-soft); line-height: 1.7;">@Model.Description</p>

            <div class="d-flex gap-2 mt-4 flex-wrap">
                <a asp-action="Index" class="btn-coquette-outline">
                    <i class="bi bi-arrow-left"></i> Назад
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-coquette-outline">
                    <i class="bi bi-pencil"></i> Редактировать
                </a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Удалить книгу? 🥺');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-coquette-outline"
                            style="border-color: #ef9a9a; color: #b71c5c !important;">
                        <i class="bi bi-trash"></i> Удалить
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>