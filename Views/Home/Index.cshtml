@{
    ViewData["Title"] = "Главная";
}

<div class="container">

    <div class="coquette-hero mb-5">
        <i class="bi bi-book-half coquette-icon"></i>
        <h1>Coquette Library</h1>
        <p>
            Добро пожаловать в нашу нежную библиотеку ♡<br />
            Здесь живут любимые книги, розовые мечты и уютные истории.
        </p>
        <a asp-controller="Book" asp-action="Index" class="btn-coquette">
            Открыть каталог
        </a>
    </div>

    <div class="coquette-divider">♡ ♡ ♡</div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="coquette-card text-center">
                <i class="bi bi-journal-bookmark coquette-icon-lg"></i>
                <h5 class="coquette-card-title">Каталог</h5>
                <p class="coquette-card-desc">Просматривайте все книги с подробной информацией.</p>
                <a asp-controller="Book" asp-action="Index" class="btn-coquette-outline btn-coquette-sm mt-auto">Открыть</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="coquette-card text-center">
                <i class="bi bi-plus-circle coquette-icon-lg"></i>
                <h5 class="coquette-card-title">Добавить</h5>
                <p class="coquette-card-desc">Добавьте новую книгу в коллекцию.</p>
                <a asp-controller="Book" asp-action="Create" class="btn-coquette-outline btn-coquette-sm mt-auto">Добавить</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="coquette-card text-center">
                <i class="bi bi-heart coquette-icon-lg"></i>
                <h5 class="coquette-card-title">Избранное</h5>
                <p class="coquette-card-desc">Редактируйте книги и отмечайте любимые.</p>
                <a asp-controller="Book" asp-action="Index" class="btn-coquette-outline btn-coquette-sm mt-auto">Управлять</a>
            </div>
        </div>
    </div>

    <p class="text-center mt-5 mb-0" style="color: var(--coq-text-soft); font-size: 0.9rem;">
        <i class="bi bi-clock"></i> @DateTime.Now.ToString("dd.MM.yyyy HH:mm:ss")
    </p>

</div>
