@page
@model wt_lab4_4mvc_valkovich.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Добавление книги";
}

<div class="container">
    <div class="coquette-form-card mx-auto" style="max-width: 700px;">
        <h2 class="coquette-form-title">Новая книга</h2>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Book.Title" class="form-label">Название</label>
                <input asp-for="Book.Title" class="form-control" placeholder="Например: Гордость и предубеждение" />
                <span asp-validation-for="Book.Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Book.Author" class="form-label">Автор</label>
                <input asp-for="Book.Author" class="form-control" placeholder="Джейн Остин" />
                <span asp-validation-for="Book.Author" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Book.Genre" class="form-label">Жанр</label>
                    <input asp-for="Book.Genre" class="form-control" placeholder="Роман" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Book.Year" class="form-label">Год издания</label>
                    <input asp-for="Book.Year" class="form-control" type="number" placeholder="1813" />
                    <span asp-validation-for="Book.Year" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Book.Price" class="form-label">Цена</label>
                    <input asp-for="Book.Price" class="form-control" type="number" step="0.01" placeholder="890" />
                    <span asp-validation-for="Book.Price" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Book.Pages" class="form-label">Количество страниц</label>
                    <input asp-for="Book.Pages" class="form-control" type="number" placeholder="432" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Book.ISBN" class="form-label">ISBN</label>
                    <input asp-for="Book.ISBN" class="form-control" placeholder="978-5-17-..." />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Book.ImageUrl" class="form-label">Ссылка на обложку</label>
                    <input asp-for="Book.ImageUrl" class="form-control" placeholder="/images/book1.jpg" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Book.Description" class="form-label">Описание</label>
                <textarea asp-for="Book.Description" class="form-control" rows="3" placeholder="Краткое описание..."></textarea>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Book.IsAvailable" class="form-check-input" />
                <label asp-for="Book.IsAvailable" class="form-check-label" style="color: var(--coq-rose); font-weight: 600;">В наличии</label>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn-coquette">Сохранить</button>
                <a asp-page="./Index" class="btn-coquette-outline">Назад</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}