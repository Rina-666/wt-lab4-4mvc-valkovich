<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] 🎀 Библиотека</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@500;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/coquette.css" asp-append-version="true" />
</head>
<body class="coquette-bg d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg coquette-navbar">
            <div class="container">
                <!-- Ссылка на главную -->
                <a class="navbar-brand" asp-page="/Index">
                    <i class="bi bi-book-half"></i> Coquette Library
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <!-- Ссылка на главную -->
                            <a class="nav-link" asp-page="/Index">
                                <i class="bi bi-house-heart"></i> Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <!-- Ссылка на каталог (страница Products/Index) -->
                            <a class="nav-link" asp-page="/Products/Index">
                                <i class="bi bi-journal-bookmark"></i> Каталог
                            </a>
                        </li>
                        <li class="nav-item">
                            <!-- Ссылка на добавление (страница Products/Create) -->
                            <a class="nav-link" asp-page="/Products/Create">
                                <i class="bi bi-plus-circle"></i> Добавить
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-5 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="coquette-footer">
        <div class="container">
            <!-- Изменил WT-4 MVC на WT-5 Razor Pages -->
            <small>♡ Сделано с любовью · Coquette Library · WT-5 Razor Pages (Валькович) ♡</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>